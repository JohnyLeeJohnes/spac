<!-- Okno aplikace. Načítá ho Spac.ps1, takže tu nejsou žádné obsluhy událostí, jen vzhled a jména prvků. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Spáč" Width="420" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Window.Resources>

        <!-- Paleta: noční obloha + měsíční žlutá. Barva Bg se zrcadlí ve Spac.ps1 (titulkový pruh). -->
        <SolidColorBrush x:Key="Bg" Color="#0F1422"/>
        <SolidColorBrush x:Key="Well" Color="#0A0E19"/>
        <SolidColorBrush x:Key="Surface" Color="#171D30"/>
        <SolidColorBrush x:Key="SurfaceHover" Color="#1E2640"/>
        <SolidColorBrush x:Key="Stroke" Color="#28304A"/>
        <SolidColorBrush x:Key="StrokeHover" Color="#3A4566"/>
        <SolidColorBrush x:Key="Text" Color="#E9ECF5"/>
        <SolidColorBrush x:Key="Muted" Color="#8891AB"/>
        <SolidColorBrush x:Key="Accent" Color="#F4C95D"/>
        <SolidColorBrush x:Key="AccentHover" Color="#F8D67E"/>
        <SolidColorBrush x:Key="AccentPressed" Color="#DDB548"/>
        <SolidColorBrush x:Key="AccentTint" Color="#1CF4C95D"/>
        <SolidColorBrush x:Key="OnAccent" Color="#1B1503"/>
        <SolidColorBrush x:Key="Danger" Color="#FF8A80"/>

        <Style x:Key="FocusRing">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border Margin="-3" CornerRadius="13" BorderThickness="2"
                                BorderBrush="{StaticResource Accent}" Opacity="0.8"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="MaxWidth" Value="280"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter>
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        </Style>

        <Style x:Key="UnitLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Margin" Value="8,0,0,11"/>
        </Style>

        <Style x:Key="Flag" TargetType="Run">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        </Style>

        <!-- Dlaždice akce: ikona ze Segoe MDL2 Assets (v Tag) nad popiskem -->
        <Style x:Key="ActionTile" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{StaticResource Surface}" BorderBrush="{StaticResource Stroke}"
                                BorderThickness="1" CornerRadius="10" Padding="2,11,2,10">
                            <StackPanel>
                                <TextBlock x:Name="Glyph" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                           HorizontalAlignment="Center"
                                           Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <ContentPresenter Margin="0,8,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHover}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource StrokeHover}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentTint}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NumberBox" TargetType="TextBox">
            <Setter Property="Width" Value="92"/>
            <Setter Property="Height" Value="64"/>
            <Setter Property="FontSize" Value="36"/>
            <Setter Property="FontWeight" Value="Light"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
            <Setter Property="SelectionOpacity" Value="0.3"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="MaxLength" Value="2"/>
            <Setter Property="InputMethod.IsInputMethodEnabled" Value="False"/>
            <Setter Property="ContextMenu" Value="{x:Null}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ToolTip" Value="Napiš číslo, nebo dolaď šipkami či kolečkem myši."/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{StaticResource Surface}" BorderBrush="{StaticResource Stroke}"
                                BorderThickness="1" CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource StrokeHover}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Chip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="{StaticResource Stroke}"
                                BorderThickness="1" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHover}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource StrokeHover}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentTint}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Řádek s přepínačem: obsah vlevo, posuvník vpravo, kliknout jde kamkoli do řádku -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="ToolTipService.ShowDuration" Value="20000"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid x:Name="Row" Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center"/>
                            <Border x:Name="Track" Grid.Column="1" Width="38" Height="22" CornerRadius="11"
                                    Margin="12,0,0,0" VerticalAlignment="Center" BorderThickness="1"
                                    Background="{StaticResource Surface}" BorderBrush="{StaticResource StrokeHover}">
                                <Ellipse x:Name="Thumb" Width="14" Height="14" Margin="3,0,0,0"
                                         HorizontalAlignment="Left" Fill="{StaticResource Muted}">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="{StaticResource OnAccent}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Thumb" To="16" Duration="0:0:0.16"
                                                             DecelerationRatio="1"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Thumb" To="0" Duration="0:0:0.16"
                                                             DecelerationRatio="1"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Row" Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource OnAccent}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource Accent}" CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface}"/>
                                <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource Surface}" BorderBrush="{StaticResource StrokeHover}"
                                BorderThickness="1" CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nenápadná pilulka pro vedlejší akce -->
        <Style x:Key="QuietButton" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTipService.ShowDuration" Value="20000"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="{StaticResource Stroke}"
                                BorderThickness="1" CornerRadius="15" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHover}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource StrokeHover}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CommandWell" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Well}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>

        <Style x:Key="CommandText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

    </Window.Resources>

    <Grid Margin="24,14,24,20">

        <!-- Nastavení -->
        <StackPanel x:Name="FormView">
            <TextBlock Style="{StaticResource SectionLabel}" Text="Co se má stát" Margin="0,0,0,8"/>
            <UniformGrid Rows="1" Margin="-4,0">
                <RadioButton x:Name="ShutdownTile" Style="{StaticResource ActionTile}" GroupName="Action"
                             Tag="&#xE7E8;" Content="Vypnout" IsChecked="True"/>
                <RadioButton x:Name="RestartTile" Style="{StaticResource ActionTile}" GroupName="Action"
                             Tag="&#xE777;" Content="Restartovat"/>
                <RadioButton x:Name="HibernateTile" Style="{StaticResource ActionTile}" GroupName="Action"
                             Tag="&#xE708;" Content="Hibernovat"/>
                <RadioButton x:Name="LogOffTile" Style="{StaticResource ActionTile}" GroupName="Action"
                             Tag="&#xF3B1;" Content="Odhlásit"/>
            </UniformGrid>

            <TextBlock Style="{StaticResource SectionLabel}" Text="Za jak dlouho" Margin="0,20,0,8"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBox x:Name="HoursBox" Style="{StaticResource NumberBox}" Text="0"
                         AutomationProperties.Name="Hodiny"/>
                <TextBlock Style="{StaticResource UnitLabel}" Text="h"/>
                <TextBox x:Name="MinutesBox" Style="{StaticResource NumberBox}" Text="30" Margin="18,0,0,0"
                         AutomationProperties.Name="Minuty"/>
                <TextBlock Style="{StaticResource UnitLabel}" Text="min"/>
            </StackPanel>

            <!-- Předvolby: Tag = počet minut -->
            <UniformGrid x:Name="Presets" Rows="1" Margin="-3,12,-3,0">
                <RadioButton Style="{StaticResource Chip}" GroupName="Preset" Tag="15" Content="15 min"/>
                <RadioButton Style="{StaticResource Chip}" GroupName="Preset" Tag="30" Content="30 min"/>
                <RadioButton Style="{StaticResource Chip}" GroupName="Preset" Tag="45" Content="45 min"/>
                <RadioButton Style="{StaticResource Chip}" GroupName="Preset" Tag="60" Content="1 h"/>
                <RadioButton Style="{StaticResource Chip}" GroupName="Preset" Tag="90" Content="1,5 h"/>
                <RadioButton Style="{StaticResource Chip}" GroupName="Preset" Tag="120" Content="2 h"/>
                <RadioButton Style="{StaticResource Chip}" GroupName="Preset" Tag="180" Content="3 h"/>
            </UniformGrid>
            <TextBlock x:Name="WhenText" Margin="0,12,0,0" HorizontalAlignment="Center"
                       Foreground="{StaticResource Muted}"/>

            <TextBlock Style="{StaticResource SectionLabel}" Text="Možnosti" Margin="0,20,0,2"/>
            <CheckBox x:Name="ForceToggle" Style="{StaticResource Switch}"
                      ToolTip="Aplikace se zavřou bez ptaní a neuložená práce se ztratí. U vypnutí a restartu s odpočtem to Windows dělá vždy, proto tu přepínač nejde vypnout.">
                <TextBlock>
                    <Run Text="Vynutit zavření aplikací"/>
                    <Run Style="{StaticResource Flag}" Text="/f"/>
                </TextBlock>
            </CheckBox>
            <CheckBox x:Name="HybridToggle" Style="{StaticResource Switch}"
                      ToolTip="Hybridní vypnutí jako u položky Vypnout v nabídce Start: počítač příště naběhne rychleji. Nejde kombinovat s obnovením aplikací.">
                <TextBlock>
                    <Run Text="Rychlé spuštění"/>
                    <Run Style="{StaticResource Flag}" Text="/hybrid"/>
                </TextBlock>
            </CheckBox>
            <CheckBox x:Name="RestoreToggle" Style="{StaticResource Switch}"
                      ToolTip="Po příštím přihlášení Windows znovu spustí aplikace, které to podporují (prohlížeč, Office apod.). Nejde kombinovat s rychlým spuštěním.">
                <TextBlock>
                    <Run Text="Po startu znovu otevřít aplikace"/>
                    <Run x:Name="RestoreFlag" Style="{StaticResource Flag}" Text="/sg"/>
                </TextBlock>
            </CheckBox>

            <Border Style="{StaticResource CommandWell}" Margin="0,12,0,0">
                <TextBlock x:Name="CommandText" Style="{StaticResource CommandText}"/>
            </Border>

            <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" Margin="0,14,0,0" IsDefault="True"/>
            <TextBlock x:Name="StatusText" Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap"
                       TextAlignment="Center" Foreground="{StaticResource Muted}"/>

            <Button x:Name="AbortButton" Style="{StaticResource QuietButton}" Margin="0,12,0,0"
                    HorizontalAlignment="Center"
                    ToolTip="Zruší jakékoli naplánované vypnutí nebo restart, i když ho nenastavil Spáč (třeba to z příkazové řádky).">
                <TextBlock>
                    <Run FontFamily="Segoe MDL2 Assets" FontSize="9" Text="&#xE711;"/>
                    <Run Text=" Zrušit naplánované vypnutí"/>
                    <Run Style="{StaticResource Flag}" Text="/a"/>
                </TextBlock>
            </Button>
        </StackPanel>

        <!-- Běžící odpočet -->
        <StackPanel x:Name="RunView" VerticalAlignment="Center" Visibility="Hidden">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Style.Triggers>
                        <Trigger Property="IsVisible" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1" Duration="0:0:0.3"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <!-- Měsíc při spuštění odpočtu vyjde -->
            <Grid Width="96" Height="96" HorizontalAlignment="Center">
                <Grid.RenderTransform>
                    <TranslateTransform/>
                </Grid.RenderTransform>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <Trigger Property="IsVisible" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                             From="28" To="0" Duration="0:0:0.8">
                                                <DoubleAnimation.EasingFunction>
                                                    <ExponentialEase EasingMode="EaseOut" Exponent="5"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Path Fill="{StaticResource Accent}">
                    <Path.Data>
                        <CombinedGeometry GeometryCombineMode="Exclude">
                            <CombinedGeometry.Geometry1>
                                <EllipseGeometry Center="44,52" RadiusX="34" RadiusY="34"/>
                            </CombinedGeometry.Geometry1>
                            <CombinedGeometry.Geometry2>
                                <EllipseGeometry Center="60,40" RadiusX="31" RadiusY="31"/>
                            </CombinedGeometry.Geometry2>
                        </CombinedGeometry>
                    </Path.Data>
                </Path>
                <!-- Dvě čtyřcípé hvězdy jako v ikoně -->
                <Path Fill="#FFF3CC" Data="M 66,22 C 67,29 67,29 74,30 C 67,31 67,31 66,38 C 65,31 65,31 58,30 C 65,29 65,29 66,22 Z"/>
                <Path Fill="#FFF3CC" Data="M 80,44 C 80.6,47.4 80.6,47.4 84,48 C 80.6,48.6 80.6,48.6 80,52 C 79.4,48.6 79.4,48.6 76,48 C 79.4,47.4 79.4,47.4 80,44 Z"/>
            </Grid>

            <TextBlock x:Name="RunTitle" FontSize="14" HorizontalAlignment="Center" Margin="0,22,0,0"/>
            <TextBlock x:Name="CountdownText" FontSize="64" FontWeight="Light" HorizontalAlignment="Center"
                       TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale"
                       Margin="0,-2,0,0"/>
            <TextBlock x:Name="RunWhen" FontSize="14" HorizontalAlignment="Center"
                       Foreground="{StaticResource Muted}"/>

            <Grid Height="4" Margin="48,24,48,0">
                <Border Background="{StaticResource Surface}" CornerRadius="2"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="BarLeft" Width="1*"/>
                        <ColumnDefinition x:Name="BarGone" Width="0*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource Accent}" CornerRadius="2"/>
                </Grid>
            </Grid>

            <Border Style="{StaticResource CommandWell}" Margin="0,32,0,0">
                <TextBlock x:Name="RunCommand" Style="{StaticResource CommandText}" HorizontalAlignment="Center"/>
            </Border>
            <Button x:Name="CancelButton" Style="{StaticResource GhostButton}" Margin="0,14,0,0" Content="Zrušit"/>
            <TextBlock x:Name="RunStatus" Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap"
                       TextAlignment="Center" Foreground="{StaticResource Muted}"/>
        </StackPanel>
    </Grid>
</Window>
